NODE_ENV=production
PORT=4000
# Supabase: Project Settings > Database > Connection string > Session pooler (IPv4 compatible).
# Use the pooler host, not the direct db.<ref>.supabase.co host.
DATABASE_URL=postgresql://postgres.<project-ref>:<db-password>@aws-0-<region>.pooler.supabase.com:5432/postgres
PGSSL=require
# Optional but recommended: path to the Supabase CA certificate (Database settings > SSL).
# Without it the connection is encrypted but the server certificate is not verified.
# PG_SSL_CA=./supabase-ca.crt
PG_POOL_MAX=5

# Required in production, 32+ random characters. The server refuses to start without it.
JWT_SECRET=
# Optional separate key for encrypting provider API keys at rest. Defaults to a key derived from JWT_SECRET.
# Changing either one makes already saved provider keys unreadable.
# ENCRYPTION_KEY=

# The first account registered becomes the admin. Set this so only you can claim it.
ADMIN_EMAIL=you@wyntek.ng
# Keep false. Admins create client workspaces from the Clients page.
ALLOW_SIGNUP=false
# Comma separated origins allowed to call the API.
FRONTEND_URL=https://mail.wyntek.ng

RESEND_API_KEY=re_xxxxxxxx
# Resend > Webhooks > Add endpoint: https://<your-render-url>/webhooks/resend
# Events: email.delivered, email.bounced, email.complained. Paste the signing secret here.
RESEND_WEBHOOK_SECRET=whsec_xxxxxxxx
# Sender for password reset and invite emails. Must be on a domain verified in Resend.
SYSTEM_FROM=Wynmail <no-reply@yourdomain.com>
PUBLIC_URL=https://api.wyntek.ng
QUEUE_TICK_MS=5000
# Minimum pause between sends across all workspaces. 500 keeps you at 2 requests per second.
SEND_GAP_MS=500
RUN_WORKER=1
# Local development without a database:
# USE_PGLITE=1
# PGLITE_DIR=./.pgdata
# FORCE_PROVIDER=console

# Domain lookups that refuse addresses at domains that cannot receive mail. Default: on, except in dry runs.
# MX_CHECK=off

# Only for tests: shorten an A/B 'hour', and remove the random spread inside a best-time hour.
# AB_HOUR_MS=3600000
# BESTTIME_JITTER_MIN=50

# Sign-in sessions end on their own after this many hours (default 168 = 7 days).
# SESSION_HOURS=168
# Failed sign-ins in 15 minutes before unfamiliar addresses are refused for that account (default 20).
# LOGIN_MAX_FAILS=20
# Where a stranger reports a vulnerability. Served at /.well-known/security.txt.
# SECURITY_CONTACT=security@wyntek.ng
# Undo window for deleted lists and templates, and how long the activity log is kept.
# DELETED_RETENTION_DAYS=30
# AUDIT_RETENTION_DAYS=400
# 0 keeps tracking events forever. Set a number of days to delete older ones.
# EVENTS_RETENTION_DAYS=0
# Database safety: connection wait, idle close, and the longest a single query may run.
# PG_CONNECT_TIMEOUT_MS=10000
# PG_IDLE_TIMEOUT_MS=30000
# PG_STATEMENT_TIMEOUT_MS=30000

# Public address of THIS server. Single sign-on uses it to build the entity ID and reply URL
# that the customer's IT team pastes into their identity provider. Must be https in production.
# PUBLIC_URL=https://api.wynmail.example
# Stop the unsent part of a campaign when this share of recipients complain, or hard-bounce (defaults 0.5% and 10%).
# PAUSE_COMPLAINT_RATE=0.005
# PAUSE_BOUNCE_RATE=0.1

# Single sign-on (SAML) and SCIM are built but switched off. Set to 1 to turn them on (also build the web app with VITE_ENABLE_SSO=1).
# ENABLE_SSO=1

# Prospector (finds business emails on company websites). It waits 2 to 3 seconds between pages and obeys robots.txt.
# PROSPECT_MAX_SITES_PER_JOB=100
# PROSPECT_DAILY_SITES=300
# Who the finder says it is to the websites it visits (default includes SECURITY_CONTACT or ADMIN_EMAIL).
# PROSPECT_UA=WynmailFinder/1.0 (business email finder; contact you@yourcompany.com)
# Set to 0 to stop this server running searches.
# RUN_PROSPECTOR=1

# SMTP mailboxes: nothing to set. Add mailboxes in Settings; Wyntek switches the workspace's provider to SMTP.
# Only for local tests (never in production): allow a local test mail server and a self-signed certificate.
# SMTP_TEST_MODE=1

NODE_ENV=production
PORT=4000
# Supabase: Project Settings > Database > Connection string > Session pooler (IPv4 compatible).
# Use the pooler host, not the direct db.<ref>.supabase.co host.
DATABASE_URL=postgresql://postgres.<project-ref>:<db-password>@aws-0-<region>.pooler.supabase.com:5432/postgres
PGSSL=require
# Optional but recommended: path to the Supabase CA certificate (Database settings > SSL).
# Without it the connection is encrypted but the server certificate is not verified.
# PG_SSL_CA=./supabase-ca.crt
PG_POOL_MAX=5

# Required in production, 32+ random characters. The server refuses to start without it.
JWT_SECRET=
# Optional separate key for encrypting provider API keys at rest. Defaults to a key derived from JWT_SECRET.
# Changing either one makes already saved provider keys unreadable.
# ENCRYPTION_KEY=

# The first account registered becomes the admin. Set this so only you can claim it.
ADMIN_EMAIL=you@wyntek.ng
# Keep false. Admins create client workspaces from the Clients page.
ALLOW_SIGNUP=false
# Comma separated origins allowed to call the API.
FRONTEND_URL=https://mail.wyntek.ng

RESEND_API_KEY=re_xxxxxxxx
PUBLIC_URL=https://api.wyntek.ng
QUEUE_TICK_MS=5000
RUN_WORKER=1
# Local development without a database:
# USE_PGLITE=1
# PGLITE_DIR=./.pgdata
# FORCE_PROVIDER=console
